# ==============================================================================
# Awaaz - Har Mazdoor Ki Awaaz Environment Variables (.env.example)
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local with live secrets.
# ==============================================================================

# --- Google Gemini API (Server-Side) ---
# Required for generative AI rights reasoning and complaint drafting.
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# --- Firebase Client Authentication (Google Sign-In) ---
# Create a Firebase project at https://console.firebase.google.com/
# 1. Register a Web App in Firebase Project Settings
# 2. Go to Authentication > Sign-in method > Enable Google
# 3. Add your deployment domain (or localhost) in Authorized domains
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
